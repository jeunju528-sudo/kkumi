# .env로 복사해서 사용 (.env는 커밋 X)

# DB
DB_USERNAME=kkumi
DB_PASSWORD=kkumi
DB_ROOT_PASSWORD=root
# prod 전용
DB_URL=jdbc:mysql://<rds-endpoint>:3306/kkumi?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# 국토부 실거래가 (공공데이터포털)
MOLIT_SERVICE_KEY=

# 한국투자증권 KIS
KIS_APP_KEY=
KIS_APP_SECRET=

# 카카오 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
