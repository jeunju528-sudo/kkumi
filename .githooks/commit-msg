#!/bin/sh
# 커밋 메시지 검사

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

case "$first_line" in
  Merge*|Revert*) exit 0 ;;
esac

if ! echo "$first_line" | grep -Eq '^(feat|fix|refactor|chore|docs|test)(\([a-z0-9-]+\))?: .+'; then
  echo "[commit-msg] 형식: feat|fix|refactor|chore|docs|test: 요약"
  echo "  입력값: $first_line"
  exit 1
fi

if grep -Eiq 'co-authored-by|generated with' "$msg_file"; then
  echo "[commit-msg] Co-Authored-By / Generated with 문구 금지"
  exit 1
fi

exit 0
